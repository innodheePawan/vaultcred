generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// USER & INVITE TABLES
// --------------------------------------

model User {
  id            String    @id @default(uuid()) @map("user_id")
  email         String    @unique
  passwordHash  String?
  name          String?   @map("full_name")
  role          String    @default("USER") // ADMIN, USER (No READ_ONLY, handled by groups)
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, INVITED
  profileImage  String?   @map("profile_image") @db.LongText
  
  // Security fields
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockExpiresAt     DateTime? @map("lock_expires_at")
  requiresCaptcha   Boolean   @default(false) @map("requires_captcha")
  
  // Invite & Auth fields
  inviteToken   String?   @map("invite_token")
  inviteExpires DateTime? @map("invite_expires")

  // 2FA Fields
  twoFactorSecret      String?   @map("two_factor_secret") @db.Text
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")

  // External Vendor Fields
  isExternal           Boolean   @default(false) @map("is_external")
  vendorName           String?   @map("vendor_name")
  externalAccessType   String?   @map("external_access_type") // e.g., 'API', 'PORTAL'
  accessExpiresAt      DateTime? @map("access_expires_at")
  allowedCategories    String?   @map("allowed_categories") @db.Text
  allowedEnvironments  String?   @map("allowed_environments") @db.Text
  allowedCredentialIds String?   @map("allowed_credential_ids") @db.Text

  createdAt     DateTime  @default(now()) @map("created_on")
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime? @map("last_login")

  // Relations
  createdCredentials      CredentialMaster[] @relation("CreatedBy")
  modifiedCredentials     CredentialMaster[] @relation("ModifiedBy")
  auditLogs               AuditLog[]         @relation("PerformedBy")
  invitesSent             Invite[]           @relation("InvitedBy")
  
  // IAM Relations
  userGroups              UserGroupMapping[]
  oneTimeSecrets          OneTimeSecret[]
  
  // API Clients
  createdApiClients       ApiClient[]        @relation("CreatedByClient")
  testedSyncTargets       SynchronizationTarget[] @relation("SyncTargetTestedBy")
  syncHistories           SyncHistory[]      @relation("SyncHistoryInitiatedBy")

  @@map("users")
}

model IpSecurity {
  id                String    @id @default(uuid()) @map("ip_security_id")
  ipAddress         String    @unique @map("ip_address")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  blockedUntil      DateTime? @map("blocked_until")
  blockCount24h     Int       @default(0) @map("block_count_24h")
  totalBlockCount   Int       @default(0) @map("total_block_count")
  lastBlockAt       DateTime? @map("last_block_at")
  isPermanentBlock  Boolean   @default(false) @map("is_permanent_block")
  
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("security_ip_blocks")
}


model Invite {
  id            String    @id @default(uuid()) @map("invite_id")
  email         String
  token         String    @unique @map("invite_token")
  role          String    @default("USER")
  expiresAt     DateTime  @map("expires_at")
  
  createdById   String    @map("invited_by")
  createdBy     User      @relation("InvitedBy", fields: [createdById], references: [id])
  
  createdAt     DateTime  @default(now()) @map("created_on")
  accepted      Boolean   @default(false)
  acceptedAt    DateTime? 
  
  // Store intended group assignments as JSON or simple relation? 
  // For simplicity, we can auto-assign generic groups or store IDs.
  // Storing as JSON string for now to be flexible on what groups they get on join.
  targetGroupIds String?  @map("target_group_ids") @db.Text
  
  targetScopedCategories    String?   @map("target_scoped_categories") @db.Text
  targetScopedEnvironments  String?   @map("target_scoped_environments") @db.Text

  // External Vendor Invite Fields
  isExternal           Boolean   @default(false) @map("is_external")
  vendorName           String?   @map("vendor_name")
  externalAccessType   String?   @map("external_access_type") // e.g., 'API', 'PORTAL'
  accessExpiresAt      DateTime? @map("access_expires_at")
  targetCredentialIds  String?   @map("target_credential_ids") @db.Text

  @@map("user_invites")
}

// --------------------------------------
// IAM: GROUPS & POLICIES
// --------------------------------------

model UserGroup {
  id          String   @id @default(uuid()) @map("group_id")
  name        String   @unique @map("group_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // e.g. "All Users", "Admins"

  createdAt   DateTime @default(now()) @map("created_on")
  updatedAt   DateTime @updatedAt @map("updated_on")

  // Relations
  members     UserGroupMapping[]
  access      UserGroupAccess[]

  @@map("iam_user_groups")
}

model UserGroupMapping {
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  groupId     String    @map("group_id")
  group       UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  assignedBy  String?   @map("assigned_by") // Audit who added them

  scopedCategories    String?   @map("scoped_categories") @db.Text
  scopedEnvironments  String?   @map("scoped_environments") @db.Text

  @@id([userId, groupId])
  @@map("iam_user_group_mapping")
}

model AccessGroup {
  id          String   @id @default(uuid()) @map("access_group_id")
  name        String   @unique @map("access_group_name") // e.g. "Engineering Read-Only"
  description String?
  
  createdAt   DateTime @default(now()) @map("created_on")
  updatedAt   DateTime @updatedAt @map("updated_on")

  // Relations
  policies    AccessGroupPolicy[]
  assignedTo  UserGroupAccess[]

  @@map("iam_access_groups")
}

model UserGroupAccess {
  userGroupId     String      @map("user_group_id")
  userGroup       UserGroup   @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  accessGroupId   String      @map("access_group_id")
  accessGroup     AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  assignedAt      DateTime    @default(now()) @map("assigned_at")
  
  @@id([userGroupId, accessGroupId])
  @@map("iam_user_group_access")
}

model AccessGroupPolicy {
  id              String      @id @default(uuid()) @map("policy_id")
  
  accessGroupId   String      @map("access_group_id")
  accessGroup     AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  // Policy Rules
  featureKey    String?     @map("feature_key")             // e.g. FEATURE:CREDENTIALS — populated by seed
  category      String?                                     // NULL = ALL categories
  environment   String?                                     // NULL = ALL environments
  permission    String                                      // ALL | ALL_SCOPED | VIEW | VIEW_MASKED | NO_ACCESS

  @@unique([accessGroupId, featureKey])                     // One policy per feature per group
  @@index([featureKey])                                     // Fast feature-based lookups
  @@map("iam_access_group_policy")
}

// --------------------------------------
// IAM FEATURE REGISTRY
// --------------------------------------

model IamFeature {
  id          String   @id @default(uuid()) @map("feature_id")
  featureKey  String   @unique @map("feature_key")  // e.g. FEATURE:CREDENTIALS
  module      String   @map("module")
  submodule   String?  @map("submodule")
  description String?
  isActive    Boolean  @default(true) @map("is_active")  // false = deprecated feature
  createdAt   DateTime @default(now()) @map("created_on")

  @@index([isActive])
  @@map("iam_features")
}

// --------------------------------------
// CREDENTIAL MASTER (PARENT)
// --------------------------------------

model CredentialMaster {
  id              String    @id @default(uuid()) @map("credential_id")
  name            String    @map("credential_name")
  type            String    @map("credential_type") // PASSWORD, API_OAUTH, KEY_CERT, TOKEN, FILE, SECURE_NOTE
  category        String?   // Application, Infra, Integration
  environment     String?   // Dev, QA, Prod
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  description     String?   @db.Text
  expiryDate      DateTime? @map("expiry_date")
  isPersonal      Boolean   @default(false) @map("is_personal")
  version         Int       @default(1)
  
  createdById     String    @map("created_by")
  createdBy       User      @relation("CreatedBy", fields: [createdById], references: [id])
  createdOn       DateTime  @default(now()) @map("created_on")
  
  lastModifiedById String   @map("last_modified_by")
  lastModifiedBy   User     @relation("ModifiedBy", fields: [lastModifiedById], references: [id])
  lastModifiedOn   DateTime @default(now()) @updatedAt @map("last_modified_on")

  // Child Tables (1:1)
  detailsPassword   CredPassword?
  detailsApi        CredApiOAuth?
  detailsKeyCert    CredKeyCert?
  detailsToken      CredToken?
  detailsFile       CredFile?
  detailsNote       CredSecureNote?

  // Relations
  // accessList        CredentialAccess[]
  auditLogs         AuditLog[]
  expiryNotify      ExpiryNotification[]

  @@index([type])
  @@index([status])
  @@index([category, environment])
  @@index([createdOn])
  @@map("credential_master")
}

// --------------------------------------
// TYPE-SPECIFIC TABLES (1:1)
// --------------------------------------

model CredPassword {
  credentialId      String   @id @map("credential_id")
  credential        CredentialMaster @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  
  username          String
  passwordEncrypted String   @map("password_encrypted") @db.Text
  host              String?
  port              Int?

  @@map("cred_password")
}

enum OAuthGrantType {
  CLIENT_CREDENTIALS
}

enum OAuthGrantTransmission {
  BODY
  URL
}

enum OAuthClientAuthentication {
  HEADER
  BODY
}

enum OAuthContentType {
  APPLICATION_X_WWW_FORM_URLENCODED
  APPLICATION_JSON
}

enum ParameterLocation {
  BODY
  HEADER
  URL
}

model CredApiOAuth {
  credentialId          String                    @id @map("credential_id")
  credential            CredentialMaster          @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  // OAuth / API fields
  clientId              String?                   @map("client_id")
  clientSecretEnc       String?                   @map("client_secret_encrypted") @db.Text
  apiKeyEncrypted       String?                   @map("api_key_encrypted") @db.Text
  tokenEndpoint         String?                   @map("token_url")
  authEndpoint          String?                   @map("auth_url") // Maintained for backward compatibility
  scope                 String?                   @map("scope") @db.Text

  // Enhanced Specification Attributes
  grantType             OAuthGrantType            @default(CLIENT_CREDENTIALS) @map("grant_type")
  grantTypeTransmission OAuthGrantTransmission    @default(BODY) @map("grant_type_transmission")
  clientAuthentication  OAuthClientAuthentication @default(HEADER) @map("client_authentication")
  contentType           OAuthContentType          @default(APPLICATION_X_WWW_FORM_URLENCODED) @map("content_type")

  resource              String?                   @map("resource")
  audience              String?                   @map("audience")
  
  // Custom Parameters stored as encrypted JSON array payload: [{ "name": "tenant", "value": "xyz", "location": "BODY" | "HEADER" | "URL" }]
  customParameters      String?                   @map("custom_parameters") @db.Text

  @@map("cred_api_oauth")
}

model CredKeyCert {
  credentialId      String   @id @map("credential_id")
  credential        CredentialMaster @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  keyType           String   @map("key_type") // SSL, SSH, PGP, TLS, SIGNING
  keyFormat         String?  @map("key_format") // PEM, DER, PFX
  publicKey         String?  @map("public_key") @db.Text
  publicKeyFileName String?  @map("public_key_filename")
  privateKeyEnc     String?  @map("private_key_encrypted") @db.Text
  privateKeyFileName String? @map("private_key_filename")
  passphraseEnc     String?  @map("passphrase_encrypted") @db.Text
  
  certificateFile   String?  @map("certificate_file") @db.Text
  certificateChain  String?  @map("certificate_chain") @db.Text
  issuer            String?
  subject           String?
  algorithm         String?
  keySize           Int?     @map("key_size")
  validFrom         DateTime? @map("valid_from")
  validTo           DateTime? @map("valid_to")
  fingerprint       String?

  @@map("cred_key_cert")
}

model CredToken {
  credentialId      String   @id @map("credential_id")
  credential        CredentialMaster @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  tokenEncrypted    String   @map("token_encrypted") @db.Text
  tokenType         String?  @map("token_type") // Bearer, JWT
  issuer            String?
  audience          String?
  issuedAt          DateTime? @map("issued_at")
  expiresAt         DateTime  @map("expires_at")

  @@map("cred_token")
}

model CredFile {
  credentialId      String   @id @map("credential_id")
  credential        CredentialMaster @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  fileName          String?  @map("file_name")
  filePath          String   @map("file_path") // Path to storage
  fileType          String?  @map("file_type") // ZIP, TAR
  filePasswordEnc   String?  @map("file_password_encrypted") @db.Text
  fileContent       String?  @map("file_content") @db.LongText

  @@map("cred_file")
}

model CredSecureNote {
  credentialId      String   @id @map("credential_id")
  credential        CredentialMaster @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  noteEncrypted     String   @map("note_encrypted") @db.LongText

  @@map("cred_secure_note")
}

model AuditLog {
  id            String    @id @default(uuid()) @map("audit_id")
  
  credentialId  String?   @map("credential_id")
  credential    CredentialMaster? @relation(fields: [credentialId], references: [id])
  
  action        String    // CREATE, UPDATE, DELETE, VIEW, DOWNLOAD, LOGIN, INVITE
  oldValue      String?   @map("old_value") @db.Text
  newValue      String?   @map("new_value") @db.Text
  
  performedById String?   @map("performed_by")
  performedBy   User?     @relation("PerformedBy", fields: [performedById], references: [id])
  
  performedOn   DateTime  @default(now()) @map("performed_on")
  ipAddress     String?   @map("ip_address")

  apiClientId   String?   @map("api_client_id")
  apiClient     ApiClient? @relation(fields: [apiClientId], references: [id])

  @@index([credentialId])
  @@index([performedById])
  @@index([apiClientId])
  @@map("audit_log")
}

model ExpiryNotification {
  id               String   @id @default(uuid()) @map("notification_id")
  credentialId     String   @map("credential_id")
  credential       CredentialMaster @relation(fields: [credentialId], references: [id])
  
  notifyBeforeDays Int      @map("notify_before_days")
  lastNotified     DateTime? @map("last_notified")

  @@map("expiry_notification")
}

model SystemSettings {
  id              Int      @id @default(1)
  applicationName String   @default("CRED Secure") @map("application_name")
  companyName     String   @default("Innodhee Services Pvt Ltd") @map("company_name")
  logoUrl         String?  @map("logo_url") @db.LongText
  themeColor      String?  @map("theme_color")
  auditPersonalCredentials Boolean @default(true) @map("audit_personal_credentials")
  twoFactorMandatory      Boolean @default(false) @map("two_factor_mandatory")
  allowApiAccess          Boolean @default(false) @map("allow_api_access")
  
  // API Throttling & Security
  exposeRateLimitHeaders  Boolean @default(false) @map("expose_rate_limit_headers")
  apiLimitAuthToken       Int     @default(10) @map("api_limit_auth_token")
  apiLimitCredentials     Int     @default(50) @map("api_limit_credentials")
  apiLimitCredentialReveal Int    @default(200) @map("api_limit_credential_reveal")
  apiLimitCredentialFile  Int     @default(30) @map("api_limit_credential_file")
  
  // SMTP Email Configuration
  smtpHost      String?  @map("smtp_host")
  smtpPort      Int?     @map("smtp_port")
  smtpUser      String?  @map("smtp_user")
  smtpPass      String?  @map("smtp_pass") @db.Text
  smtpFromEmail String?  @map("smtp_from_email")
  smtpSecure    Boolean  @default(true) @map("smtp_secure")
  
  updatedAt   DateTime @updatedAt @map("updated_on")
  updatedBy   String?  @map("updated_by")

  lastLoginArchivedAt DateTime? @map("last_login_archived_at")
  lastArchiveBatchId  String?   @map("last_archive_batch_id")

  // RBAC version — increment on seed run, role change, or group mapping change
  // Used for version-based cache invalidation of userContext and globalActiveFeatures
  rbacVersion Int @default(1) @map("rbac_version")

  @@map("system_settings")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_on")

  @@map("password_reset_tokens")
}

model TwoFactorResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_on")

  @@map("two_factor_reset_tokens")
}

model LoginLog {
  id                String   @id @default(uuid()) @map("log_id")
  email             String
  outcome           String   // SUCCESS, FAILURE, BLOCKED
  category          String   // AUTHENTICATION, MFA, ACCOUNT_STATUS
  reasonCode        String   @map("reason_code")
  reasonMessage     String?  @map("reason_message") @db.Text
  authMethod        String   @map("auth_method")
  ipAddress         String   @map("ip_address")
  userAgent         String?  @map("user_agent") @db.Text
  deviceFingerprint String?  @map("device_fingerprint")
  geoCountry        String?  @map("geo_country")
  riskLevel         String   @map("risk_level") // LOW, MEDIUM, HIGH
  
  timestamp         DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([outcome])
  @@map("security_login_logs")
}

model LoginLogArchive {
  id                String   @id @default(uuid()) @map("archive_id")
  originalLogId     String   @map("original_log_id")
  email             String
  outcome           String
  category          String
  reasonCode        String   @map("reason_code")
  reasonMessage     String?  @map("reason_message") @db.Text
  authMethod        String   @map("auth_method")
  ipAddress         String   @map("ip_address")
  userAgent         String?  @map("user_agent") @db.Text
  deviceFingerprint String?  @map("device_fingerprint")
  geoCountry        String?  @map("geo_country")
  riskLevel         String   @map("risk_level")
  
  timestamp         DateTime // Original timestamp
  
  // Archival metadata
  archiveBatchId    String   @map("archive_batch_id")
  archivedAt        DateTime @default(now()) @map("archived_at")
  archivedBy        String   @default("SYSTEM") @map("archived_by")

  @@index([archiveBatchId])
  @@index([email])
  @@map("security_login_logs_archive")
}


// --------------------------------------
// ONE-TIME SECRETS
// --------------------------------------
model OneTimeSecret {
  id             String    @id @default(uuid()) @map("secret_id")
  name           String?
  secretData     String    @map("secret_data") @db.LongText
  token          String    @unique
  
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  maxViews       Int       @default(1) @map("max_views")
  currentViews   Int       @default(0) @map("current_views")
  expiresAt      DateTime  @map("expires_at")
  
  sharedVia      String    @default("LINK") @map("shared_via") // LINK, EMAIL
  recipientEmail String?   @map("recipient_email")
  
  createdById    String    @map("created_by")
  createdBy      User      @relation(fields: [createdById], references: [id])
  createdAt      DateTime  @default(now()) @map("created_on")

  @@map("one_time_secrets")
}

// --------------------------------------
// LICENSE ACTIVATION
// --------------------------------------
model LicenseRegistry {
  id        String   @id @default(uuid()) @map("id")
  regKey    String   @map("reg_key") @db.VarChar(100)
  regValue  Bytes    @map("reg_value") @db.LongBlob
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("license_registry")
}

model LicenseAlertLog {
  id             String   @id @default(uuid()) @map("id")
  milestoneType  String   @map("milestone_type") @db.VarChar(50)
  licenseVersion String   @map("license_version") @db.VarChar(100)
  sentAt         DateTime @default(now()) @map("sent_at")

  @@unique([milestoneType, licenseVersion])
  @@map("license_alert_log")
}

// --------------------------------------
// EXTERNAL API CLIENTS
// --------------------------------------

model ApiClient {
  id                    String    @id @default(uuid()) @map("api_client_id")
  name                  String    @map("client_name")
  clientId              String    @unique @map("client_id")
  clientSecretHash      String    @map("client_secret_hash") @db.Text
  certificateThumbprint String?   @map("cert_thumbprint")  
  securityMode          String    @default("BASIC") @map("security_mode")
  allowFileDownload     Boolean   @default(false) @map("allow_file_download")
  
  scopes                String    @map("scopes") @db.Text  // JSON: { "applications": [], "environments": [], "credentialTypes": [], "accessMode": "READ_ONLY" }
  isActive              Boolean   @default(true) @map("is_active")
  tokenValiditySeconds  Int       @default(300) @map("token_validity_seconds")
  secretExpiresAt       DateTime? @map("secret_expires_at")
  lastUsedAt            DateTime? @map("last_used_at")

  createdById           String    @map("created_by")
  createdBy             User      @relation("CreatedByClient", fields: [createdById], references: [id])
  createdAt             DateTime  @default(now()) @map("created_on")
  
  updatedAt             DateTime  @updatedAt @map("updated_on")

  auditLogs             AuditLog[]

  @@map("api_clients")
}

model ApiActivityLog {
  id                  String   @id @default(uuid()) @map("log_id")
  apiClientId         String?  @map("api_client_id")
  clientName          String?  @map("client_name")
  
  endpoint            String   @map("endpoint")
  method              String   @map("method")
  timestamp           DateTime @default(now())
  requestId           String?  @map("request_id")
  
  authType            String?  @map("auth_type") // OAUTH_ONLY, OAUTH_CERT, OAUTH_CERT_VALIDATION
  certificateIdentity String?  @map("certificate_identity")
  validationStatus    String?  @map("validation_status") // SUCCESS, FAILED
  
  responseStatus      String   @map("response_status") // SUCCESS, FAILURE
  httpStatusCode      Int      @map("http_code")
  errorMessage        String?  @map("error_message") @db.Text
  
  credentialId        String?  @map("credential_id")
  application         String?  @map("application")
  environment         String?  @map("environment")
  action              String   @map("action") // LIST, VIEW
  
  requestedScope      String?  @map("requested_scope")
  assignedScope       String?  @map("assigned_scope") @db.Text

  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent") @db.Text

  @@index([apiClientId])
  @@index([endpoint])
  @@map("api_activity_log")
}

// --------------------------------------
// RELEASE NOTES / CHANGELOG
// --------------------------------------

model ReleaseNote {
  id          String   @id @default(uuid()) @map("note_id")
  version     String   @map("version") @db.VarChar(20)       // e.g. "v2.4.0"
  title       String   @map("title")                          // Short summary
  tag         String   @map("tag") @db.VarChar(20)            // Fix, Feature, Enhancement, Performance
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isActive, createdAt])
  @@map("release_notes")
}

model UserNotificationRead {
  userId        String   @map("user_id")
  lastReadNoteId String? @map("last_read_note_id")            // ID of the latest ReleaseNote they viewed
  readAt        DateTime @default(now()) @map("read_at")

  @@id([userId])
  @@map("user_notification_read")
}

enum SyncTargetStatus {
  ENABLED
  DISABLED
}

enum ConnectionHealth {
  NEVER_TESTED
  HEALTHY
  FAILED
}

model SynchronizationTarget {
  id                 String             @id @default(uuid()) @map("sync_target_id")
  name               String             @unique @map("target_name")
  description        String?            @map("description") @db.Text
  type               String             @map("target_type") // Currently "SAP_BTP_INTEGRATION_SUITE"
  status             SyncTargetStatus   @default(ENABLED) @map("status")
  
  hostUrl            String             @map("host_url")
  tokenUrl           String             @map("token_url")
  clientId           String             @map("client_id")
  clientSecret       String             @map("client_secret") @db.Text // Encrypted (AES-256-GCM)
  certificate        String?            @map("certificate") @db.LongText // Encrypted (AES-256-GCM)
  
  tenantLabel        String             @map("tenant_label")
  
  categories         Json               @map("categories")
  types              Json               @map("types")
  environments       Json?              @map("environments")
  
  // Connection Metrics
  connectionHealth   ConnectionHealth   @default(NEVER_TESTED) @map("connection_health")
  lastTestTimestamp  DateTime?          @map("last_test_timestamp")
  lastTestResponseTime Int?             @map("last_test_response_time")
  lastTestHttpStatus Int?               @map("last_test_http_status")
  lastTestError      String?            @map("last_test_error") @db.Text
  
  testedById         String?            @map("tested_by_id")
  testedBy           User?              @relation("SyncTargetTestedBy", fields: [testedById], references: [id])

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  syncHistories      SyncHistory[]

  @@map("synchronization_targets")
}

model SyncHistory {
  id                    String                @id @default(uuid()) @map("sync_history_id")
  sessionId             String                @map("session_id")
  
  targetId              String                @map("target_id")
  target                SynchronizationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  
  targetName            String                @map("target_name")
  targetType            String                @map("target_type")
  platform              String                @map("platform")
  provider              String                @map("provider")
  hostUrl               String                @map("host_url")
  
  credentialId          String?               @map("credential_id")
  credentialName        String                @map("credential_name")
  credentialType        String                @map("credential_type")
  version               Int                   @map("version")
  category              String?               @map("category")
  environment           String?               @map("environment")
  
  operation             String                @map("operation") // CREATE, UPDATE
  executionType         String                @map("execution_type") // AUTO, MANUAL, BULK, API
  
  startedAt             DateTime              @map("started_at")
  completedAt           DateTime              @map("completed_at")
  durationMs            Int                   @map("duration_ms")
  
  initiatedById         String?               @map("initiated_by_id")
  initiatedBy           User?                 @relation("SyncHistoryInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedByName       String                @map("initiated_by_name")
  
  status                String                @map("status") // PENDING, IN_PROGRESS, SUCCESS, FAILED, SKIPPED
  parentHistoryId       String?               @map("parent_history_id")
  
  endpoint              String                @map("endpoint")
  httpMethod            String                @map("http_method")
  
  requestHeaders        String?               @map("request_headers") @db.Text
  requestBody           String?               @map("request_body") @db.Text
  httpStatus            Int?                  @map("http_status")
  responseHeaders       String?               @map("response_headers") @db.Text
  responseBody          String?               @map("response_body") @db.Text
  providerCorrelationId String?               @map("provider_correlation_id")
  errorMessage          String?               @map("error_message") @db.Text

  @@index([targetId])
  @@index([initiatedById])
  @@index([sessionId])
  @@map("sync_history")
}

