# Database Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/vaultcred"

# Encryption key for stored credentials (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=""

# NextAuth session signing secret (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Application URL
NEXTAUTH_URL="http://localhost:3000"

# (Amplify only) Public-facing app URL
# NEXT_PUBLIC_APP_URL="https://your-domain.amplifyapp.com"
